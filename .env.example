# Database
# PostgreSQL database URL (e.g., Neon, Supabase)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# GitHub API
# Create a personal access token at: https://github.com/settings/tokens
# No special permissions needed, just for higher rate limits
GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# LLM API Key
# Get OpenRouter API key from: https://openrouter.ai/keys
# Or use any OpenAI-compatible API key
LLM_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Cron Secret
# Generate a random string for security (e.g., use: openssl rand -base64 32)
CRON_SECRET="your-random-secret-string-here"

# Public URL (update when deployed)
NEXT_PUBLIC_APP_URL="http://localhost:3000"