generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Change {
  id            String   @id
  service       String
  category      String
  documentType  String
  filename      String?
  commitSha     String
  commitDate    DateTime
  commitUrl     String
  diffContent   String
  diffSummary   String?
  processed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  isMinorChange Boolean  @default(false)

  @@index([category])
  @@index([commitDate])
  @@index([commitSha])
  @@index([processed])
  @@index([service])
  @@index([isMinorChange])
}

model LastCheck {
  id            String   @id
  repo          String   @unique
  lastCommitSha String
  checkedAt     DateTime @default(now())

  @@index([repo])
}
